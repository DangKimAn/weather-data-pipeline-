import pandas 
import boto3 
from dotenv import load_dotenv 
import os 
import json 
import io


file_name_on_s3 ='Ho Chi Minh City/2026/7/2/1782963697.json'
dot_env_loc = '../config/.env'
load_dotenv(dot_env_loc)
access_key = os.getenv('AWS_ACCESS_KEY')
secret_key = os.getenv('AWS_SECRET_KEY')
s3_client = boto3.client('s3',
        aws_access_key_id=access_key,
        aws_secret_access_key= secret_key,
        region_name='us-east-1')

bucket_name = 'weather-pipeline-kiman'



response = s3_client.get_object(Bucket=bucket_name, Key=file_name_on_s3)


file_content = response['Body'].read()


raw = json.loads(file_content)


raw


